# Copy to .env and fill in as needed. All three are optional.

# Public read access is enough. If blank, scripts fall back to `gh auth token`.
GITHUB_TOKEN=

# Any Gemma 4 tag from `ollama list`. Defaults to gemma4:e4b.
OLLAMA_MODEL=gemma4:e4b

# Ollama endpoint. Defaults to http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# SQLite file. Defaults to file:./data/vouch.db
DATABASE_URL=file:./data/vouch.db

# Optional: shared trust index (Lakebase Postgres on Neon), read-only.
# Unset = the app runs on local SQLite alone, exactly as before.
# Use the pooled (-pooler) host, with a SELECT-only role.
NEON_DATABASE_URL=

# Write credential for the standalone enrichment process (scripts/sharedCrawl.ts) ONLY.
# Use the DIRECT (non-pooler) owner string. The app must never use this one.
NEON_WRITE_URL=
